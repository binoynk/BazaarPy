# ─────────────────────────────────────────────────────────────────
# Bazaar frontend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
#
# Vite only exposes variables prefixed with VITE_ to client-side code
# (via import.meta.env) — this is the anon/public key, safe to ship
# to the browser (it has no admin rights; row access is still gated
# by whatever the backend/RLS enforces).
# ─────────────────────────────────────────────────────────────────

# Get from: Supabase → Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Get from: Supabase → Settings → API → Project API keys → anon public
VITE_SUPABASE_ANON_KEY=your-anon-key
